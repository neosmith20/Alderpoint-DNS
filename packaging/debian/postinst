#!/bin/sh
set -e

# Fresh scrypt hash of a secret using dnsdist's own hashPassword(), so the
# result can go straight into setWebserverConfig()'s password/apiKey fields
# without dnsdist ever seeing (or warning about) the plaintext. $1 is a path
# to a file whose first line is the plaintext value to hash.
alderpointdns_dnsdist_hash() {
  value_file="$1"
  hash_script="$(mktemp)"
  cat > "$hash_script" <<HASHEOF
local f = io.open("$value_file", "r")
local v = f:read("l")
f:close()
print("ALDERPOINTDNS_HASH_OUTPUT:" .. hashPassword(v))
HASHEOF
  dnsdist --check-config -C "$hash_script" 2>/dev/null | sed -n 's/^ALDERPOINTDNS_HASH_OUTPUT://p'
  rm -f "$hash_script"
}

# Poll for a service reaching the active state instead of checking once
# immediately after `systemctl restart`/`enable --now`: on Type=simple
# units systemctl returns as soon as the restart is *initiated*, before a
# fast-crashing service (bad config, permissions, AppArmor denial) has
# necessarily been marked failed yet.
alderpointdns_wait_active() {
  svc="$1"
  i=0
  while [ "$i" -lt 15 ]; do
    if systemctl is-active --quiet "$svc"; then
      return 0
    fi
    i=$((i + 1))
    sleep 1
  done
  return 1
}

case "$1" in
  configure)
    if ! getent group alderpointdns >/dev/null; then
      addgroup --system alderpointdns
    fi
    if ! id alderpointdns >/dev/null 2>&1; then
      adduser --system --home /var/lib/alderpointdns --no-create-home --ingroup alderpointdns --disabled-login alderpointdns
    fi
    install -d -o alderpointdns -g alderpointdns -m 0750 /var/lib/alderpointdns/backups /var/lib/alderpointdns/imports /var/lib/alderpointdns/staging
    # 0755, not 0750: named and dnsdist (separate system accounts,
    # unrelated to alderpointdns) must be able to traverse into these two
    # directories to reach their own generated config under
    # compiled/bind/ and compiled/dnsdist/ -- those files are root-owned
    # and world-readable already (written by the root-escalated deploy
    # path), so these two directories only need to be enterable, not
    # additionally restricted. backups/imports/staging above hold
    # sensitive content directly and stay locked to the alderpointdns
    # group only.
    install -d -o alderpointdns -g alderpointdns -m 0755 /var/lib/alderpointdns /var/lib/alderpointdns/compiled
    install -d -o alderpointdns -g alderpointdns -m 0755 /var/log/alderpointdns
    # named (its own "bind" system user, unrelated to alderpointdns) writes
    # its own log/statistics files directly here; it must own this
    # subdirectory rather than inherit the alderpointdns ownership above.
    install -d -o bind -g bind -m 0750 /var/log/alderpointdns/bind
    # 0755, not 0750: dnsdist's separate "_dnsdist" system account (and any
    # other daemon reading its own narrowly-owned subdirectory here, such as
    # named's log directory above) needs to traverse into this directory by
    # default; the sensitive files/subdirs directly inside it (secrets.env,
    # dnsdist-api.key, dnsdist-web.creds, certs/) are individually locked
    # down to their own owner/group instead.
    install -d -o root -g alderpointdns -m 0755 /etc/alderpointdns
    # ensure_tls_cert.sh creates /etc/alderpointdns/certs itself, owned
    # root:_dnsdist -- dnsdist (a separate system account, unrelated to
    # alderpointdns) must be able to read its own TLS certificate/key
    # directly. It is deliberately not created here with the alderpointdns
    # group above, which would leave dnsdist unable to load its TLS material
    # and crash-loop as soon as an encrypted listener (DoH/DoT/DoQ, enabled
    # by default in packaging/dnsdist.service.d/alderpointdns.conf) starts.
    /opt/alderpointdns/scripts/ensure_tls_cert.sh

    if [ ! -e /etc/alderpointdns/secrets.env ]; then
      # Subshell: `umask` is a whole-process setting with no block scope in
      # POSIX sh, and everything alderpointdns_compiler.py's deploy step
      # creates below (compiled zone/config files named needs to read) must
      # not inherit this restrictive 077 meant only for the secret itself.
      (
        umask 077
        printf 'ALDERPOINTDNS_SESSION_SECRET=%s\n' "$(openssl rand -base64 48)" > /etc/alderpointdns/secrets.env
      )
    fi
    if [ ! -e /etc/alderpointdns/dnsdist-api.key ]; then
      ( umask 077; openssl rand -base64 32 > /etc/alderpointdns/dnsdist-api.key )
    fi
    if [ ! -e /etc/alderpointdns/dnsdist-web.creds ]; then
      ( umask 077; printf 'alderpointdns:%s\n' "$(openssl rand -base64 24)" > /etc/alderpointdns/dnsdist-web.creds )
    fi
    # root:alderpointdns 0640 (not the umask-derived 0600 these were created
    # with above): the alderpointdns service account -- not just root --
    # legitimately needs to read all three at runtime (session secret,
    # dnsdist API key, dnsdist web credentials), and 0640 keeps that read
    # access scoped to root and the alderpointdns group only, nothing wider.
    chown root:alderpointdns /etc/alderpointdns/secrets.env /etc/alderpointdns/dnsdist-api.key /etc/alderpointdns/dnsdist-web.creds
    chmod 0640 /etc/alderpointdns/secrets.env /etc/alderpointdns/dnsdist-api.key /etc/alderpointdns/dnsdist-web.creds

    # AppArmor local override for named: without this, BIND's own AppArmor
    # profile (loaded from the bind9 package, independent of Unix
    # permissions) denies named read access to the generated RPZ/local-zone
    # config under /var/lib/alderpointdns/compiled/bind/, even though the
    # files themselves are perfectly readable by the "bind" user -- named
    # fails to start with a "permission denied" error that looks identical
    # to a Unix permissions problem but isn't one. Appended (not
    # overwritten) and guarded by a marker so repeated installs/upgrades
    # stay idempotent and never clobber other local customizations already
    # in this file.
    apparmor_local=/etc/apparmor.d/local/usr.sbin.named
    apparmor_marker="# Alderpoint DNS local override -- see /opt/alderpointdns/packaging/apparmor-named.local"
    if [ -d /etc/apparmor.d/local ]; then
      if [ ! -e "$apparmor_local" ] || ! grep -qF "$apparmor_marker" "$apparmor_local" 2>/dev/null; then
        {
          printf '%s\n' "$apparmor_marker"
          cat /opt/alderpointdns/packaging/apparmor-named.local
        } >> "$apparmor_local"
      fi
      # Reload the compiled profile so a running named picks up the new
      # rule immediately, without waiting for a reboot; guarded so this is
      # a no-op on systems where AppArmor isn't installed/enabled (e.g.
      # some containers) rather than failing the whole install over it.
      if command -v apparmor_parser >/dev/null 2>&1 \
          && [ -e /sys/module/apparmor/parameters/enabled ] \
          && [ "$(cat /sys/module/apparmor/parameters/enabled)" = "Y" ] \
          && [ -e /etc/apparmor.d/usr.sbin.named ]; then
        apparmor_parser -r /etc/apparmor.d/usr.sbin.named || true
      fi
    fi

    # Base BIND/dnsdist configuration that `include`s the generated files
    # under /var/lib/alderpointdns/compiled -- without these, named and
    # dnsdist run with the upstream bind9/dnsdist packages' stock defaults
    # and never load Alderpoint DNS's RPZ filtering, ACLs, or listeners at
    # all. Only written on first install (never overwritten on upgrade,
    # matching scripts/install.sh's equivalent one-time template install)
    # so operator edits to these files are never clobbered by a reinstall.
    #
    # The "first install" markers deliberately live under /etc/alderpointdns
    # (removed by `apt purge`), not next to the files they guard in
    # /etc/bind or /etc/dnsdist (owned by the separate bind9/dnsdist
    # packages, untouched by our purge) -- a marker that survived purge
    # would make a subsequent reinstall skip regenerating dnsdist.conf's
    # per-install console/web/API secrets entirely, silently reusing
    # dnsdist config that authenticates against credentials the purge just
    # deleted from /etc/alderpointdns. Purge is meant to reset everything
    # this package manages, including these two templates.
    if [ ! -e /etc/alderpointdns/.named-conf-installed ]; then
      install -D -m 0644 /opt/alderpointdns/packaging/named.conf.options /etc/bind/named.conf.options
      install -D -m 0644 /opt/alderpointdns/packaging/named.conf.local /etc/bind/named.conf.local
      : > /etc/alderpointdns/.named-conf-installed
    fi
    if [ ! -e /etc/alderpointdns/.dnsdist-conf-installed ]; then
      install -D -m 0644 /opt/alderpointdns/packaging/dnsdist.conf /etc/dnsdist/dnsdist.conf
      # Fresh, per-install random secrets for dnsdist's console encryption
      # key and web/API credentials -- the shipped template ships literal
      # ALDERPOINTDNS_*_PLACEHOLDER tokens, not a real secret, so the same
      # value is never reused across installs. The web password and API key
      # go into dnsdist.conf as dnsdist's own hashPassword() output
      # (scrypt), computed once here from the plaintext already generated
      # above into dnsdist-web.creds/dnsdist-api.key -- that's what actually
      # silences dnsdist's "passed a plain-text password/API key" warning,
      # without weakening anything: the plaintext dnsdist itself checks
      # incoming credentials against is unchanged, it's just no longer
      # duplicated a second time, in the clear, inside dnsdist.conf. The
      # console key has no hashed form (it's a symmetric encryption key for
      # the console protocol, not a password dnsdist verifies), so it's
      # substituted as-is.
      console_key="$(openssl rand -base64 32)"
      web_password_file="$(mktemp)"
      ( umask 077; cut -d: -f2- /etc/alderpointdns/dnsdist-web.creds > "$web_password_file" )
      web_password_hash="$(alderpointdns_dnsdist_hash "$web_password_file")"
      rm -f "$web_password_file"
      api_key_hash="$(alderpointdns_dnsdist_hash /etc/alderpointdns/dnsdist-api.key)"
      if [ -z "$web_password_hash" ] || [ -z "$api_key_hash" ]; then
        echo "alderpointdns: failed to compute dnsdist webserver credential hashes; aborting install." >&2
        exit 1
      fi
      sed -i \
        -e "s|ALDERPOINTDNS_CONSOLE_KEY_PLACEHOLDER|$console_key|" \
        -e "s|ALDERPOINTDNS_WEBSERVER_PASSWORD_PLACEHOLDER|$web_password_hash|" \
        -e "s|ALDERPOINTDNS_WEBSERVER_API_KEY_PLACEHOLDER|$api_key_hash|" \
        /etc/dnsdist/dnsdist.conf
      if grep -q 'ALDERPOINTDNS_.*_PLACEHOLDER' /etc/dnsdist/dnsdist.conf; then
        echo "alderpointdns: dnsdist.conf still contains unresolved secret placeholders after substitution; aborting install." >&2
        exit 1
      fi
      : > /etc/alderpointdns/.dnsdist-conf-installed
    fi
    # On an upgrade, the block above is skipped (the marker file already
    # exists) and /etc/dnsdist/dnsdist.conf keeps whatever an earlier
    # version of this package -- or the administrator -- last wrote, which
    # can predate later per-feature changes to the managed sections of the
    # template (e.g. the doh-altsvc Alt-Svc header block). Applying those
    # narrowly-scoped migrations here means an upgraded install picks up
    # the new managed behavior automatically, without a full re-template
    # that would discard any local hand-edits elsewhere in the file. Each
    # migration validates and backs up before touching anything and is a
    # no-op once already applied, so this is safe and cheap on every
    # install/upgrade, not just when there's actually something to migrate.
    # Idempotently installs any vendor/*.whl into vendor-runtime/ for a
    # requirements.txt pin ahead of what Debian's own package archive
    # carries (see app/alderpointdns_compiler.py's
    # sync_vendored_python_deps() docstring). A no-op whenever nothing
    # under vendor/ applies.
    if ! vendor_deps_sync_output="$(PYTHONPATH=/opt/alderpointdns /opt/alderpointdns/app/alderpointdns_compiler.py vendor-deps-sync)"; then
      echo "alderpointdns: vendored Python dependency sync failed; aborting install." >&2
      exit 1
    fi
    echo "alderpointdns: vendor dependency sync: $vendor_deps_sync_output"
    # NOT dnsdist-conf-migrate here (deliberately moved below, after
    # fresh-install-init/analytics.py init-db -- see the comment there):
    # it calls into app/clients.py's ensure_access_data_files(), which
    # unconditionally calls clients.py's own, separate init_db() to make
    # sure its data-file-rendering read has a schema to query. clients.py's
    # init_db() is real CREATE TABLE IF NOT EXISTS DDL against the shared
    # database file, so running it here -- before fresh-install-init's own
    # freshness check -- made has_established_database_state() see an
    # already-non-empty database on every single fresh install (not a rare
    # race: this ran unconditionally, every time), silently skipping the
    # default blocklist seed and initial deploy exactly like the
    # analytics.py ordering bug below, just via a different module. Found
    # running the real tests/test_clean_install_container.sh against a
    # genuinely clean Debian 13 container: fresh_install=0 on every run,
    # and /var/lib/alderpointdns/compiled/bind/alderpointdns.rpz was never
    # created.

    # systemd-resolved's stub DNS listener is enabled by default on
    # Debian 12/13 and Ubuntu and binds specific loopback aliases
    # (127.0.0.53:53, sometimes also 127.0.0.54:53) without SO_REUSEPORT.
    # Because a *wildcard* bind (0.0.0.0:53, what dnsdist needs) on a port
    # already claimed by any non-SO_REUSEPORT socket -- even one bound to
    # a different, more specific address -- is refused by the kernel,
    # dnsdist's own bind to port 53 fails with EADDRINUSE on a completely
    # unmodified, default fresh install, before this package's own config
    # is even a factor. systemd-resolved's LLMNR responder (also enabled
    # by default) binds 0.0.0.0:5355 the same way, which conflicts
    # identically with dnsdist's own loopback upstream-routing listener
    # (127.0.0.1:5355 -- see app/upstream_dns.py's LOOPBACK_FORWARDER_PORT
    # and ensure_dnsdist_include()). Disable only the stub listener and
    # LLMNR; systemd-resolved keeps running and NSS/D-Bus-based name
    # resolution (the "resolve" nsswitch.conf module) is unaffected --
    # only these two legacy listeners go away, freeing both ports.
    if systemctl is-active --quiet systemd-resolved 2>/dev/null; then
      install -d -m 0755 /etc/systemd/resolved.conf.d
      cat > /etc/systemd/resolved.conf.d/alderpointdns-disable-stub.conf <<'RESOLVEDCONF'
# Installed by alderpointdns (packaging/debian/postinst). Alderpoint DNS
# itself listens on ports 53 and 5355 (via dnsdist) once installed;
# systemd-resolved's stub listener and LLMNR responder conflict with
# those binds (see postinst for the full explanation). Only these two
# listeners are disabled -- systemd-resolved keeps running for
# everything else.
[Resolve]
DNSStubListener=no
LLMNR=no
RESOLVEDCONF
      systemctl restart systemd-resolved
      # /etc/resolv.conf is normally a symlink to systemd-resolved's
      # dynamic stub file (nameserver 127.0.0.53), which stops answering
      # once the stub listener above is disabled. Repoint it at this
      # host's own Alderpoint DNS listener -- the intended end state for
      # a host running Alderpoint DNS as its resolver anyway -- but only
      # when it's still the default symlink/absent; an administrator's
      # own static /etc/resolv.conf (a real, non-symlink file) is left
      # alone rather than silently overwritten.
      if [ -L /etc/resolv.conf ]; then
        rm -f /etc/resolv.conf
        cat > /etc/resolv.conf <<'RESOLVCONFEOF'
# Managed by alderpointdns. systemd-resolved's stub listener was disabled
# (see /etc/systemd/resolved.conf.d/alderpointdns-disable-stub.conf) so
# Alderpoint DNS's own dnsdist could bind port 53. Points at this host's
# own Alderpoint DNS listener.
nameserver 127.0.0.1
options edns0 trust-ad
RESOLVCONFEOF
      fi
    fi

    install -d -m 0755 /etc/systemd/system/dnsdist.service.d
    # Only bootstrap the packaged *default* env-override drop-in when one
    # isn't already present. On a real install this file isn't static
    # packaging content: app/encryption.py's render_env_override() rewrites
    # it from the live Encryption Settings (DoH/DoT/DoQ/DoH3/DNSCrypt
    # enabled state, listen addresses, ports, and the active
    # certificate/key paths) every time an administrator saves/deploys
    # encryption configuration. Unconditionally overwriting it here on
    # every package upgrade -- as this used to do -- silently reverted a
    # live server's actual encryption configuration (e.g. DoQ/DoH3 an
    # administrator had turned on) back to the packaged fresh-install
    # defaults on every `apt install`/upgrade, without changing the
    # database those settings are supposedly read from: the Encryption
    # Settings page would keep reporting the admin's real configuration
    # while dnsdist quietly ran with the wrong one until the next manual
    # re-save. Found live testing a real `apt install ./alderpointdns.deb`
    # upgrade with DoQ/DoH3 already enabled. A fresh install has no prior
    # drop-in to preserve, so it still gets the safe packaged default
    # (everything but plain/DoH/DoT off) exactly as before.
    if [ ! -e /etc/systemd/system/dnsdist.service.d/alderpointdns.conf ]; then
      install -m 0644 /opt/alderpointdns/packaging/dnsdist.service.d/alderpointdns.conf /etc/systemd/system/dnsdist.service.d/alderpointdns.conf
    fi
    # NOT analytics.py init-db here (deliberately moved below,
    # after fresh-install-init): analytics.py's own init-db subcommand
    # calls alderpointdns_compiler.py's init_db() unconditionally, which
    # -- on a genuinely fresh database -- applies the full schema and
    # bumps PRAGMA user_version to SCHEMA_VERSION as a side effect. If
    # that ran first, fresh-install-init's own init_db(seed_defaults=True)
    # call below would see current_version already >= SCHEMA_VERSION and
    # return immediately without ever seeding the default blocklists or
    # attempting the initial deploy -- silently turning every fresh
    # install into a no-op. Running analytics.py init-db after
    # fresh-install-init keeps the freshness check correct while still
    # being a no-op change in effect (it is idempotent CREATE TABLE IF
    # NOT EXISTS statements either way).
    systemctl daemon-reload >/dev/null 2>&1 || true
    # named.conf.local above unconditionally `include`s the generated
    # local-zones.conf; alderpointdns_compiler.py deploy (below) bootstraps
    # that file itself once it runs, but reload_bind() at the end of deploy
    # needs an *already-running* named to `rndc reload` -- it can't start
    # named itself. Historically this relied on bind9's own postinst having
    # already started named earlier in this same dpkg transaction, with its
    # stock config, before named.conf.local above was overwritten; that's
    # true on a normal system, but silently breaks deploy (a confusing rndc
    # "connection refused" rather than a clear error) whenever it isn't --
    # e.g. bind9 was installed in an earlier, separate step, or something
    # stopped named in between. Create the same empty bootstrap placeholder
    # deploy() would and (re)start named explicitly here so this doesn't
    # depend on another package's maintainer script side effect.
    # named.conf.options only ever gains its `include
    # ".../cache-options.conf"` line the first time DNS Cache Settings is
    # deployed (dns_cache.ensure_named_options_include(), called from
    # deploy_cache_options() below) -- but once added, that line is
    # permanent (named.conf.options is a first-install-only template, never
    # rewritten on upgrade; see the marker-guarded block above). If
    # /var/lib/alderpointdns is ever missing at that point while the
    # include line already persists in named.conf.options -- e.g. `apt
    # purge` followed by reinstall without also resetting bind9's own
    # config, or any other loss of just the compiled state directory --
    # this same bootstrap placeholder pattern applies: an empty
    # cache-options.conf is a valid, honest "no cache tuning applied yet"
    # bootstrap default that lets named start at all, and
    # deploy_cache_options() below replaces it with the real content in
    # the same run regardless.
    # Same reasoning as cache-options.conf above applies to
    # upstream-forwarders.conf (app/upstream_dns.py's
    # deploy_upstreams()): once its own `include` line is added to
    # named.conf.options by a first successful deploy, it's permanent.
    # Unlike cache-options.conf/local-zones.conf, an *empty* file isn't a
    # safe placeholder here: named.conf.options also unconditionally sets
    # `forward only;`, and BIND treats that combined with a `forwarders`
    # statement that resolves to zero addresses as a fatal config error
    # ("no matching 'forwarders' statement"), not a silently-ignored
    # no-op. Render the real function's own default (a loopback forwarder
    # back to Alderpoint DNS's own dnsdist upstream-routing listener) so
    # the placeholder is never invalid -- and deploy_upstreams() below
    # replaces it with the administrator's actual configured upstreams in
    # the same run regardless.
    install -d -m 0755 /var/lib/alderpointdns/compiled/bind
    [ -e /var/lib/alderpointdns/compiled/bind/local-zones.conf ] || install -m 0644 /dev/null /var/lib/alderpointdns/compiled/bind/local-zones.conf
    [ -e /var/lib/alderpointdns/compiled/bind/cache-options.conf ] || install -m 0644 /dev/null /var/lib/alderpointdns/compiled/bind/cache-options.conf
    if [ ! -e /var/lib/alderpointdns/compiled/bind/upstream-forwarders.conf ]; then
      PYTHONPATH=/opt/alderpointdns python3 -c \
        "from app import upstream_dns; print(upstream_dns.render_bind_forwarders(), end='')" \
        > /var/lib/alderpointdns/compiled/bind/upstream-forwarders.conf
    fi
    systemctl restart named
    # On a genuinely fresh database, seed the ordinary recommended
    # blocklist rows and run the normal download/compile/deploy path. On
    # upgrades/reinstalls this command is a strict no-op, keyed by the
    # schema user_version established during the first initialization; it
    # must not reseed sources or replace an existing compiled policy.
    PYTHONPATH=/opt/alderpointdns /opt/alderpointdns/app/alderpointdns_compiler.py fresh-install-init
    # Must run after fresh-install-init (see the comment above the removed
    # earlier call) so the freshness check above sees the database exactly
    # as fresh-install-init left it; this call itself is an idempotent
    # no-op either way once the schema already exists.
    PYTHONPATH=/opt/alderpointdns /opt/alderpointdns/app/analytics.py init-db
    # Also deliberately after fresh-install-init/analytics.py init-db, for
    # exactly the same reason -- see the comment moved from this call's
    # original, earlier position above. Must still run before the final
    # `systemctl restart named dnsdist` below so a migrated/validated
    # /etc/dnsdist/dnsdist.conf is in place before that restart picks it up.
    if ! dnsdist_conf_migrate_output="$(PYTHONPATH=/opt/alderpointdns /opt/alderpointdns/app/alderpointdns_compiler.py dnsdist-conf-migrate)"; then
      echo "alderpointdns: dnsdist.conf managed-block migration failed; aborting install." >&2
      exit 1
    fi
    echo "alderpointdns: dnsdist.conf migration: $dnsdist_conf_migrate_output"
    # Validated on every configure (not just first install): even when the
    # template above isn't rewritten on an upgrade, a bad or hand-edited
    # /etc/dnsdist/dnsdist.conf should never be silently restarted into.
    if ! dnsdist --check-config -C /etc/dnsdist/dnsdist.conf; then
      echo "alderpointdns: /etc/dnsdist/dnsdist.conf failed validation; aborting install." >&2
      exit 1
    fi
    # The database (created above by fresh-install-init on a new install,
    # or migrated there on an existing install, running as root in this
    # postinst) is the one thing under /var/lib/alderpointdns that both
    # needs fixing up and is safe to hand to alderpointdns: unlike
    # backups/imports/staging (already alderpointdns-owned from the
    # directory creation above and never written to as root) or
    # compiled/bind and compiled/dnsdist (deliberately kept root-owned and
    # world-readable -- named/dnsdist only ever read them, and the *only*
    # way to regenerate them is the audited, sudo-gated deploy path;
    # handing alderpointdns direct ownership would let anything running as
    # that account rewrite live BIND/dnsdist config without going through
    # it), the database is the one file the alderpointdns and
    # alderpointdns-analytics services genuinely need to open read-write
    # themselves. -wal/-shm may or may not exist yet depending on
    # checkpoint timing, hence the existence checks.
    for alderpointdns_db_file in /var/lib/alderpointdns/alderpointdns.db /var/lib/alderpointdns/alderpointdns.db-wal /var/lib/alderpointdns/alderpointdns.db-shm; do
      if [ -e "$alderpointdns_db_file" ]; then
        chown alderpointdns:alderpointdns "$alderpointdns_db_file"
      fi
    done
    # Deliberately not recursive: /etc/alderpointdns/certs is owned and
    # managed entirely by ensure_tls_cert.sh/app/encryption.py (root:_dnsdist
    # for the TLS-serving cert/key, root:root for the CA key) so that
    # dnsdist -- a separate system account with no relationship to
    # alderpointdns -- can read its own TLS material directly. Recursing
    # into it here would silently reassign that directory back to
    # alderpointdns and break dnsdist's cert access.
    chown root:alderpointdns /etc/alderpointdns
    chown root:alderpointdns /etc/alderpointdns/secrets.env /etc/alderpointdns/dnsdist-api.key /etc/alderpointdns/dnsdist-web.creds
    chmod 0640 /etc/alderpointdns/secrets.env /etc/alderpointdns/dnsdist-api.key /etc/alderpointdns/dnsdist-web.creds

    # A previous failed install (e.g. of an earlier broken version) may have
    # left named/dnsdist/alderpointdns/alderpointdns-analytics in systemd's
    # "failed, start-limit exceeded" state; clear that before restarting so
    # the checks below reflect this install's actual outcome, not stale
    # state from a prior one.
    systemctl reset-failed named dnsdist alderpointdns alderpointdns-analytics >/dev/null 2>&1 || true
    systemctl restart named dnsdist
    # `enable --now` on an *already-active* unit (the normal upgrade case)
    # only ensures it is enabled/running -- it does not restart an
    # already-running process, so this package's own updated code
    # (app/webapp.py, app/*.py) and, critically, an updated
    # alderpointdns.service unit file itself (e.g. its ProtectSystem
    # sandboxing/ReadWritePaths) would silently keep running under the
    # *previous* version's process/mount namespace until something else
    # happened to restart it. `enable` (idempotent, harmless if already
    # enabled) plus an explicit unconditional `restart` -- exactly the
    # same pattern already used for named/dnsdist above -- guarantees
    # every install and upgrade actually runs what was just installed.
    systemctl enable alderpointdns alderpointdns-analytics
    systemctl restart alderpointdns alderpointdns-analytics
    # Scheduled backups and automatic filter updates are both timer-driven.
    # Enabling is idempotent, and filter-schedule-deploy writes the
    # filter-update timer drop-in from the stored Filter Update Interval
    # (preserved across upgrades; 1 Day on a fresh install). Best-effort:
    # unlike the four core services above, these are periodic background
    # automation, not required for the appliance to come up correctly.
    systemctl enable alderpointdns-backup.timer >/dev/null 2>&1 || true
    systemctl enable alderpointdns-filter-update.timer >/dev/null 2>&1 || true
    systemctl enable --now alderpointdns-notify.timer >/dev/null 2>&1 || true
    # Automatic update *checking* is on by default (never automatic
    # *installation* -- see software_update_settings.unattended_install_enabled,
    # which defaults off and has no timer of its own in this release).
    # update-check-schedule-deploy writes the automatic-check timer
    # drop-in from the stored auto_check_enabled/check_interval_hours
    # settings (preserved across upgrades; enabled/6h on a fresh install),
    # exactly mirroring filter-schedule-deploy below -- see
    # app/software_updates.py's deploy_check_schedule().
    PYTHONPATH=/opt/alderpointdns /opt/alderpointdns/app/alderpointdns_compiler.py update-check-schedule-deploy >/dev/null 2>&1 || true
    PYTHONPATH=/opt/alderpointdns /opt/alderpointdns/app/alderpointdns_compiler.py filter-schedule-deploy >/dev/null 2>&1 || true

    # Final gate: confirm the four services this package ships/depends on
    # for core function are actually up, not just that systemctl accepted
    # the restart/enable commands. A permission, ownership, AppArmor, or
    # dnsdist-config-compatibility problem can make every step above
    # "succeed" while the service itself immediately crash-loops; without
    # this, `apt install` reports success regardless.
    for alderpointdns_svc in named dnsdist alderpointdns alderpointdns-analytics; do
      if ! alderpointdns_wait_active "$alderpointdns_svc"; then
        echo "alderpointdns: $alderpointdns_svc did not reach the active state after installation." >&2
        echo "alderpointdns: check 'systemctl status $alderpointdns_svc' and 'journalctl -u $alderpointdns_svc -n 50' for details." >&2
        exit 1
      fi
    done
    ;;
esac

#DEBHELPER#
exit 0
