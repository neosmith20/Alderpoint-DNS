#!/bin/sh
set -e

case "$1" in
  configure)
    if ! getent group alderpointdns >/dev/null; then
      addgroup --system alderpointdns
    fi
    if ! id alderpointdns >/dev/null 2>&1; then
      adduser --system --home /var/lib/alderpointdns --no-create-home --ingroup alderpointdns --disabled-login alderpointdns
    fi
    install -d -o alderpointdns -g alderpointdns -m 0750 /var/lib/alderpointdns /var/lib/alderpointdns/backups /var/lib/alderpointdns/compiled /var/lib/alderpointdns/imports /var/lib/alderpointdns/staging
    install -d -o alderpointdns -g alderpointdns -m 0755 /var/log/alderpointdns
    # named (its own "bind" system user, unrelated to alderpointdns) writes
    # its own log/statistics files directly here; it must own this
    # subdirectory rather than inherit the alderpointdns ownership above.
    install -d -o bind -g bind -m 0750 /var/log/alderpointdns/bind
    # 0755, not 0750: dnsdist's separate "_dnsdist" system account (and any
    # other daemon reading its own narrowly-owned subdirectory here, such as
    # named's log directory above) needs to traverse into this directory by
    # default; the sensitive files/subdirs directly inside it (secrets.env,
    # dnsdist-api.key, dnsdist-web.creds, certs/) are individually locked
    # down to their own owner/group instead.
    install -d -o root -g alderpointdns -m 0755 /etc/alderpointdns
    # ensure_tls_cert.sh creates /etc/alderpointdns/certs itself, owned
    # root:_dnsdist -- dnsdist (a separate system account, unrelated to
    # alderpointdns) must be able to read its own TLS certificate/key
    # directly. It is deliberately not created here with the alderpointdns
    # group above, which would leave dnsdist unable to load its TLS material
    # and crash-loop as soon as an encrypted listener (DoH/DoT/DoQ, enabled
    # by default in packaging/dnsdist.service.d/alderpointdns.conf) starts.
    /opt/alderpointdns/scripts/ensure_tls_cert.sh
    if [ ! -e /etc/alderpointdns/secrets.env ]; then
      umask 077
      printf 'ALDERPOINTDNS_SESSION_SECRET=%s\n' "$(openssl rand -base64 48)" > /etc/alderpointdns/secrets.env
      chown root:alderpointdns /etc/alderpointdns/secrets.env
    fi
    PYTHONPATH=/opt/alderpointdns /opt/alderpointdns/app/analytics.py init-db || true
    systemctl daemon-reload >/dev/null 2>&1 || true
    # Scheduled backups and automatic filter updates are both timer-driven.
    # Enabling is idempotent, and filter-schedule-deploy writes the
    # filter-update timer drop-in from the stored Filter Update Interval
    # (preserved across upgrades; 1 Day on a fresh install).
    systemctl enable alderpointdns-backup.timer >/dev/null 2>&1 || true
    systemctl enable alderpointdns-filter-update.timer >/dev/null 2>&1 || true
    PYTHONPATH=/opt/alderpointdns /opt/alderpointdns/app/alderpointdns_compiler.py filter-schedule-deploy >/dev/null 2>&1 || true
    ;;
esac

#DEBHELPER#
exit 0
