#!/bin/sh
set -e

case "$1" in
  configure)
    if ! getent group bindguard >/dev/null; then
      addgroup --system bindguard
    fi
    if ! id bindguard >/dev/null 2>&1; then
      adduser --system --home /var/lib/bindguard --no-create-home --ingroup bindguard --disabled-login bindguard
    fi
    install -d -o bindguard -g bindguard -m 0750 /var/lib/bindguard /var/lib/bindguard/backups /var/lib/bindguard/compiled /var/lib/bindguard/imports /var/lib/bindguard/staging
    install -d -o bindguard -g bindguard -m 0755 /var/log/bindguard
    install -d -o root -g bindguard -m 0750 /etc/bindguard /etc/bindguard/certs
    if [ ! -e /etc/bindguard/secrets.env ]; then
      umask 077
      printf 'BINDGUARD_SESSION_SECRET=%s\n' "$(openssl rand -base64 48)" > /etc/bindguard/secrets.env
      chown root:bindguard /etc/bindguard/secrets.env
    fi
    PYTHONPATH=/opt/bindguard /opt/bindguard/app/analytics.py init-db || true
    systemctl daemon-reload >/dev/null 2>&1 || true
    ;;
esac

#DEBHELPER#
exit 0
