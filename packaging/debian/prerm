#!/bin/sh
set -e

case "$1" in
  remove|deconfigure)
    # Real defect found live during a real V1.1.1 -> V2 in-place package
    # migration (apt's Conflicts/Replaces triggers exactly this prerm
    # path): alderpointdns-notify.timer was never added to this stop/
    # disable list even though postrm's purge case already knows about
    # it (see its timers.target.wants cleanup below) -- a real removal
    # left it "not-found failed" in systemd's own view, the unit file
    # already deleted by dpkg but systemd never told to stop it first.
    systemctl stop alderpointdns.service alderpointdns-analytics.service alderpointdns-backup.timer alderpointdns-filter-update.timer alderpointdns-notify.timer alderpointdns-software-update-check.timer alderpointdns-software-update.service >/dev/null 2>&1 || true
    systemctl disable alderpointdns-backup.timer alderpointdns-filter-update.timer alderpointdns-notify.timer alderpointdns-software-update-check.timer >/dev/null 2>&1 || true
    ;;
esac

#DEBHELPER#
exit 0
