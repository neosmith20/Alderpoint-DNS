[Unit]
Description=Alderpoint DNS Web Application
After=network-online.target named.service dnsdist.service
Wants=network-online.target
# Caps runaway restart loops (e.g. a bad secrets.env/database permission
# regression) at 5 attempts per minute instead of restarting forever;
# systemd marks the unit failed once the limit is hit rather than pounding
# it indefinitely.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
User=alderpointdns
Group=alderpointdns
WorkingDirectory=/opt/alderpointdns
Environment=PYTHONPATH=/opt/alderpointdns
ExecStart=/usr/bin/uvicorn app.webapp:app --host 0.0.0.0 --port 3000
Restart=on-failure
RestartSec=3
# NoNewPrivileges is deliberately NOT set: alderpointdns legitimately escalates
# via sudo to the exact, argument-free, sudoers-enumerated
# alderpointdns_compiler.py subcommands every privileged feature (cache,
# encryption, backup, import deploy, replication enrollment) relies on.
# NoNewPrivileges=true silently breaks sudo (which needs to gain
# privileges via its setuid-root binary) with no working alternative here;
# the real access-control boundary is the narrow sudoers allowlist itself,
# not this flag.
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/alderpointdns /var/log/alderpointdns /etc/alderpointdns

[Install]
WantedBy=multi-user.target
