[Unit]
Description=Alderpoint DNS Web Application
After=network-online.target named.service dnsdist.service
Wants=network-online.target
# Caps runaway restart loops (e.g. a bad secrets.env/database permission
# regression) at 5 attempts per minute instead of restarting forever;
# systemd marks the unit failed once the limit is hit rather than pounding
# it indefinitely.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
User=alderpointdns
Group=alderpointdns
WorkingDirectory=/opt/alderpointdns
Environment=PYTHONPATH=/opt/alderpointdns
ExecStart=/usr/bin/uvicorn app.webapp:app --host 0.0.0.0 --port 3000
Restart=on-failure
RestartSec=3
# NoNewPrivileges is deliberately NOT set: alderpointdns legitimately escalates
# via sudo to the exact, argument-free, sudoers-enumerated
# alderpointdns_compiler.py subcommands every privileged feature (cache,
# encryption, backup, import deploy, replication enrollment) relies on.
# NoNewPrivileges=true silently breaks sudo (which needs to gain
# privileges via its setuid-root binary) with no working alternative here;
# the real access-control boundary is the narrow sudoers allowlist itself,
# not this flag.
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
# ProtectSystem=full read-only-bind-mounts /usr, /boot, and /etc for this
# unit's private mount namespace -- and, since `sudo` execs the privileged
# alderpointdns_compiler.py subcommands as a child of *this* process
# without creating a new mount namespace of its own, that read-only bind
# applies to those privileged children too, even running as root. Most
# privileged writes land under /var/lib/alderpointdns or /etc/alderpointdns
# (already listed below) with named/dnsdist's own managed `include`d files
# bootstrapped once, unsandboxed, by packaging/debian/postinst -- but
# app/network_config.py's per-backend persistent config (netplan YAML,
# systemd-networkd .network drop-ins, ifupdown /etc/network/interfaces[.d])
# has no such postinst bootstrap and is written directly by the live,
# sandboxed request path, so those directories must be explicitly
# writable or every backend's Apply fails with EROFS.
# app/backup.py's restore path (bind_source_config, dnsdist_source_config,
# and app_config components) directly replaces live files under
# /etc/bind, /etc/dnsdist, /etc/systemd/system/{alderpointdns,
# alderpointdns-analytics,dnsdist}.service[.d], and /etc/sudoers.d --
# same ProtectSystem=full read-only-/etc problem as the network backends
# above, this time surfaced by a real ~296 MiB restore on a disposable VM
# (see the completion report) rather than a mocked one. This does not
# widen what the *untrusted* web process itself can write (it has no
# write access to any of these paths at the filesystem-permission level
# either way, running unprivileged) -- it only lifts the mount-level
# read-only restriction for the sudo-escalated, sudoers-allowlisted
# alderpointdns_compiler.py restore path, which already only ever writes
# validated archive content from a backup that itself went through
# app/backup.py's extraction/traversal/size validation.
#
# Of the paths below, only ONE of /etc/netplan, /etc/systemd/network, and
# /etc/network is ever actually in use on a given host -- app/network_config.py's
# detect_backend() picks exactly one supported networking backend per host
# (Netplan, systemd-networkd, or ifupdown; NetworkManager needs no writable
# config directory here, it's driven entirely through nmcli), and a real
# Debian install is not guaranteed to have all three backends' packages
# installed. /etc/netplan in particular is Ubuntu-centric and does not
# exist on a stock Debian system with no netplan.io package -- confirmed by
# a live beta.6 -> 1.0.0 upgrade on a Debian appliance with no /etc/netplan,
# where systemd's mount-namespace setup for this unit's ReadWritePaths=
# failed outright (status=226/NAMESPACE) because ReadWritePaths= entries
# are not implicitly optional; a *missing* entry here is fatal to the whole
# unit, unlike a missing ReadOnlyPaths= entry. These three are therefore
# each prefixed with "-" (systemd.exec(5): a leading "-" makes the entry a
# no-op instead of a startup failure when the path does not exist), so the
# two backend directories nobody uses on this host are silently skipped
# instead of blocking startup. This is deliberately NOT applied to any of
# the other paths in this list: /var/lib/alderpointdns, /var/log/alderpointdns,
# and /etc/alderpointdns are created unconditionally by packaging/debian/postinst
# before this unit is ever started; /etc/bind, /etc/dnsdist, and
# /etc/sudoers.d come from this package's own hard Depends (bind9, dnsdist,
# sudo) and are guaranteed present by dpkg once those packages are unpacked;
# /etc/systemd/system is created by systemd itself on every system that can
# run this unit at all. None of those six can legitimately be absent, so
# silently ignoring their absence would only hide a real misconfiguration
# instead of tolerating an expected, backend-dependent one -- this does not
# broadly weaken the writable-path hardening, it narrows the "-" prefix to
# exactly the three backend-selection paths that are allowed to not exist.
ReadWritePaths=/var/lib/alderpointdns /var/log/alderpointdns /etc/alderpointdns -/etc/netplan -/etc/systemd/network -/etc/network /etc/bind /etc/dnsdist /etc/systemd/system /etc/sudoers.d

[Install]
WantedBy=multi-user.target
