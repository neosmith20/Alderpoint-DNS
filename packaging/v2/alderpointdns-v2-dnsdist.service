[Unit]
Description=Alderpoint DNS V2 packaged dnsdist runtime (private candidate)
Documentation=man:dnsdist(1)
After=network.target
ConditionPathExists=/var/lib/alderpointdns-v2/compiled/dnsdist.conf
# Real defect found by hardware/performance load testing (roadmap
# Priority 3), same root cause as
# alderpointdns-v2-dnsdist-reload.service's own comment: this unit is
# restarted (not reloaded -- dnsdist has no live-reload for Lua-defined
# rules) by that reload unit once per compiled-runtime promotion. Raising
# only the reload unit's own start-rate limit surfaced the exact same
# failure one layer deeper -- a legitimate burst of rapid admin changes
# (e.g. bulk-importing local DNS records) then hit THIS unit's default
# systemd start-rate limit (5 restarts per 10s) instead, taking real live
# DNS answering down entirely (`failed (Result: start-limit-hit)`) until
# manual intervention, which is strictly worse than the reload unit
# merely falling behind. Matches the same generous-but-bounded limit.
StartLimitIntervalSec=60
StartLimitBurst=200

[Service]
Type=simple
User=alderpointdns-v2
Group=alderpointdns-v2
Environment=HOME=/var/lib/alderpointdns-v2
ExecStart=/usr/bin/dnsdist -C /var/lib/alderpointdns-v2/compiled/dnsdist.conf --supervised --disable-syslog
Restart=on-failure
RestartSec=3
TimeoutStartSec=20
TimeoutStopSec=15

# DNS answering is intentionally independent of the management UI,
# analytics, discovery, replication, DuckDB, and Tier B workers. This unit
# only reads the already-promoted runtime artifact. Management mutations
# compile/validate/promote that artifact transactionally before operators
# reload or restart this runtime.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/var/lib/alderpointdns-v2/compiled
ReadWritePaths=/var/log/alderpointdns-v2
UMask=0027
# Real defect found live during KVM clean-install/reboot acceptance
# (owner-beta closure pass): this cap was 512M, sized without ever
# actually measuring dnsdist's own steady-state footprint with the
# real, default three-blocklist configuration this exact package seeds
# on first install (AdGuard DNS filter + StevenBlack Unified Hosts +
# HaGeZi Multi Normal, ~450k+ combined domains compiled into dnsdist's
# in-memory ruleset). Measured live (MemoryMax temporarily lifted to
# `infinity` via `systemctl set-property` on a real fresh KVM install,
# real DNS traffic still flowing throughout): steady state is ~569M
# RSS with the full default ruleset loaded, before any query-cache
# growth on top of that. 512M was therefore *always* going to be
# exceeded by dnsdist's own default configuration, not just under
# load -- systemd's memory cgroup killed the real dnsdist process
# every single time it tried to load the real default ruleset,
# producing an unconditional crash loop (`Failed with result
# 'oom-kill'`, `restart counter` climbing without bound) with DNS
# answering never coming up at all. 1024M keeps a real, bounded cap
# (this is deliberately still not "unlimited") with real headroom
# above the measured ~569M baseline for the query-cache growth the
# aging/soak evidence already showed (up to ~303M RSS growth toward
# its own configured 10,000-entry cap) plus a safety margin, while
# still protecting the host from genuine unbounded runaway growth.
MemoryMax=1024M

[Install]
WantedBy=multi-user.target
