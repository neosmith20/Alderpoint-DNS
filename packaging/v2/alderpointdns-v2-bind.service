[Unit]
Description=Alderpoint DNS V2 packaged BIND recursive-cache backend (private candidate)
Documentation=man:named(8)
After=network.target
Before=alderpointdns-v2-dnsdist.service
ConditionPathExists=/var/lib/alderpointdns-v2/compiled/bind/named.conf
# Same real defect/fix as alderpointdns-v2-dnsdist.service's own comment
# (roadmap Priority 3): this unit is restarted (not reloaded -- a changed
# forwarders/RPZ set needs a full named restart in this bounded design,
# unlike a live rndc-managed instance) once per compiled-runtime
# promotion. Matches the same generous-but-bounded start-rate limit.
StartLimitIntervalSec=60
StartLimitBurst=200

[Service]
Type=notify
Environment=HOME=/var/lib/alderpointdns-v2
# named itself drops privileges to alderpointdns-v2-bind/alderpointdns-v2
# via -u once bound to its (unprivileged, >1024) loopback ports -- no
# CAP_NET_BIND_SERVICE is needed here, unlike the V2 dnsdist unit, since
# neither 5453 nor 5553 is a privileged port. Starting as root only long
# enough to open its own state/log directories, then dropping, mirrors
# the exact pattern already proven for V1's named.service.
ExecStart=/usr/sbin/named -c /var/lib/alderpointdns-v2/compiled/bind/named.conf -u alderpointdns-v2 -f
Restart=on-failure
RestartSec=3
TimeoutStartSec=20
TimeoutStopSec=15

# BIND architecture correction (Gate #3): this unit is the real, packaged
# V2 recursive-cache tier -- client -> dnsdist packet cache -> compiled
# policy/routing -> BIND RAM recursive cache -> upstream (the locked
# docs/v2/architecture-map.md hot path). It is intentionally independent
# of the management UI, analytics, discovery, replication, DuckDB, and
# Tier B workers -- it only reads the already-promoted runtime artifact
# alongside alderpointdns-v2-dnsdist.service.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# AF_NETLINK is required (real defect found live during Gate #3 clean-
# install acceptance testing): named calls getifaddrs()/opens a route
# socket at startup to enumerate real interfaces, even when every
# listen-on address is already an explicit loopback literal (never a
# wildcard) -- without AF_NETLINK this fails ("interfaceiter.c:
# isc_interfaceiter_create(): unexpected error", "not listening on any
# interfaces") and the whole unit comes up with NO listeners at all
# (systemd reports it "active (running)" the entire time, since named
# itself never crashes -- only a real port-level check catches this, not
# systemctl status). Confirmed live: identical config started correctly
# outside this unit's sandboxing, isolating the restriction itself as
# the cause, not the config or the target environment.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadOnlyPaths=/var/lib/alderpointdns-v2/compiled
ReadWritePaths=/var/lib/alderpointdns-v2/bind /var/log/alderpointdns-v2/bind
UMask=0027
MemoryMax=512M

[Install]
WantedBy=multi-user.target
