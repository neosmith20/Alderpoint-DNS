[Unit]
Description=Alderpoint DNS V2 management/API service (private candidate, native HTTPS)
# DNS-first startup order (locked architecture): this unit is NOT a
# dependency of any DNS-serving process in either direction. If this
# service fails to start entirely, compiled DNS (generated separately by
# `alderpointdns-v2-ctl generate-runtime`, run once at postinst and again
# by alderpointdns-v2-schedule.service on transitions) is completely
# unaffected -- nothing about DNS answering depends on this process being
# up.
After=network.target

[Service]
Type=simple
User=alderpointdns-v2
Group=alderpointdns-v2
# ExecStartPre re-asserts the TLS bootstrap on every start (not just
# install) -- idempotent (ensure_bootstrap_cert only regenerates if the
# active pair is absent/invalid), so this is a no-op on every normal
# start and a real self-heal if certificate material was ever lost
# without a full reinstall. Deliberately calls `ensure-tls-cert`, NOT the
# broader `init-state` -- init-state also touches /etc/alderpointdns-v2,
# which is outside this unit's ReadWritePaths= under ProtectSystem=strict
# and would fail every start with a real permission error (found via
# clean-install testing; see docs/v2/clean-install-evidence.md).
ExecStartPre=/usr/bin/python3 -B /opt/alderpointdns-v2/scripts/v2/alderpointdns_v2_ctl.py ensure-tls-cert
ExecStart=/usr/bin/uvicorn app.v2.webapp:app --app-dir /opt/alderpointdns-v2 --host 0.0.0.0 --port 8443 --ssl-certfile /var/lib/alderpointdns-v2/certs/server.crt --ssl-keyfile /var/lib/alderpointdns-v2/certs/server.key
Environment=PYTHONPATH=/opt/alderpointdns-v2/vendor-runtime-v2-analytics:/opt/alderpointdns-v2
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=15

# Hardening (§38). Documented exceptions:
#  - NoNewPrivileges=true is safe here (unlike V1's webapp unit, which
#    needs sudo escalation for privileged compiler subcommands): this
#    service never shells out to a privileged helper, it only reads/
#    writes its own state directories directly as alderpointdns-v2.
#  - ReadWritePaths covers control.db, secrets, analytics, staging,
#    compiled runtime, certs, and backups -- everything a management API
#    request can legitimately mutate. /opt/alderpointdns-v2 itself is
#    read-only at runtime (ProtectSystem=strict default): this process
#    never modifies its own installed code.
#  - /etc/alderpointdns-v2 is now also a ReadWritePath (real defect found
#    live via a KVM acceptance boot, not by unit tests: EVERY policy
#    mutation that goes through _mutate_and_promote() -- Local DNS,
#    clients, filtering, blocklists, upstream profiles, schedules, 16
#    call sites total -- passes RNDC_CONF_PATH under CONFIG_DIR
#    (/etc/alderpointdns-v2/rndc.conf) to runtime_compile so DNS Cache
#    flush (beta-rescue priority 3A) keeps working off the freshly
#    promoted rndc key. Writing it failed silently as a read-only-
#    filesystem OSError under this unit's own ProtectSystem=strict, which
#    _mutate_and_promote's all-or-nothing transaction correctly treated
#    as "promotion failed, roll back the control.db write too" -- so the
#    control.db side effect was never left half-applied, but literally no
#    operator-driven policy change could ever be saved through the web
#    UI/API on a real install. The scheduled recompile path (see
#    alderpointdns-v2-schedule.service) never hit this because it never
#    passes live_rndc_conf_path; only this unit's *interactive* mutations
#    do. This grants write access to the appliance's own DNS runtime
#    config directory, not secret material -- real secrets stay under
#    /var/lib/alderpointdns-v2/secrets, already writable above with its
#    own separate 0600/dedicated-directory protection.
#  - AF_NETLINK is in RestrictAddressFamilies (real defect found live via
#    a KVM acceptance boot, not by unit tests: app.network_config's
#    read-only interface/address detection -- used by both GET
#    /api/network/status and first-run setup's local-DNS IP auto-detect
#    -- shells out to `ip`, which opens an AF_NETLINK socket even for a
#    plain read. Without it here, that subprocess call fails silently
#    under this unit's own seccomp filter and every caller sees "no
#    interface detected", not an error -- the Network Configuration page
#    always showed empty current state and first-run setup could never
#    auto-detect the appliance's own address. This grants only a
#    read-capable socket family, never a new capability -- the process
#    still cannot itself apply a network change (CapabilityBoundingSet=
#    stays empty below; real interface changes remain the separate,
#    privileged network-apply/-confirm oneshot units this one only
#    requests via a state-file marker).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/alderpointdns-v2 /var/log/alderpointdns-v2 /etc/alderpointdns-v2
UMask=0027
CapabilityBoundingSet=
# Real defect class found live during a real KVM acceptance pass (see
# alderpointdns-v2-schedule.service's own comment for the full root
# cause): every real policy mutation through the management API calls
# _mutate_and_promote(), which runs the same real
# stage_validate_promote_all() -> `dnsdist --check-config` /
# `named-checkconf` / `named-checkzone` subprocesses in-process, and
# those children inherit this unit's own cgroup the same way. 768M
# left uncomfortably little headroom above this service's own real
# steady-state footprint (~150-180M observed) plus a real validator
# child's peak (~569M+ against the full default blocklist ruleset,
# see alderpointdns-v2-dnsdist.service's own comment) -- close enough
# to the edge that ordinary growth (more blocklist entries, more
# concurrent requests) could tip it into the same cgroup-oom crash
# this pass found for alderpointdns-v2-schedule.service. Raised to the
# same 1024M floor for real, matching headroom.
MemoryMax=1024M

[Install]
WantedBy=multi-user.target
