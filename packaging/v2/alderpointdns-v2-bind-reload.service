[Unit]
Description=Reload Alderpoint DNS V2 packaged BIND after runtime promotion
StartLimitIntervalSec=60
StartLimitBurst=200

[Service]
Type=oneshot
# Multi-context BIND (Gate #3 acceptance closure): a bounded, fixed set
# of possible context instances (see app/v2/bind_gen.py's
# MAX_BIND_CONTEXTS) are restarted unconditionally on every promotion.
# Each instance's own ConditionPathExists (packaging/v2/
# alderpointdns-v2-bind@.service) makes this safe and correct for
# contexts NOT in the current generation -- systemd's restart verb stops
# whatever was previously running for that instance, then skips the
# start half when the condition fails, so a context that existed in a
# previous generation but not this one is correctly torn down, not left
# stale. Restarted before dnsdist so a generation that also touched
# dnsdist.conf never has dnsdist pointed at a BIND context that hasn't
# picked up its new config yet.
ExecStart=/bin/systemctl restart alderpointdns-v2-bind@ctx0.service alderpointdns-v2-bind@ctx1.service alderpointdns-v2-bind@ctx2.service alderpointdns-v2-bind@ctx3.service
