[Unit]
Description=Watch Alderpoint DNS V2 promoted BIND runtime for reload
StartLimitIntervalSec=60
StartLimitBurst=200

[Path]
# Multi-context BIND: watch the whole compiled bind directory (its mtime
# changes whenever any context's named.conf, or the shared RPZ zone, is
# (re)written by stage_validate_promote_all) rather than one fixed
# filename -- the exact set of context subdirectories present varies
# per compile.
PathChanged=/var/lib/alderpointdns-v2/compiled/bind
Unit=alderpointdns-v2-bind-reload.service

[Install]
WantedBy=multi-user.target
