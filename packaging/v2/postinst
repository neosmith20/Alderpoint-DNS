#!/bin/sh
set -e

# Alderpoint DNS V2 -- PRIVATE CANDIDATE package lifecycle. Fully separate
# namespace from the live V1 "alderpointdns" package: own user/group
# (alderpointdns-v2), own paths (/opt/alderpointdns-v2, /etc/alderpointdns-v2,
# /var/lib/alderpointdns-v2, /var/log/alderpointdns-v2), own systemd units
# (alderpointdns-v2-*). Never touches anything V1 owns. The packaged V2
# dnsdist unit reads only /var/lib/alderpointdns-v2/compiled/dnsdist.conf
# and is intended for isolated/private V2 targets, not co-installation on a
# live V1 appliance.

V2_SERVICES="alderpointdns-v2-bind@ctx0.service alderpointdns-v2-bind-reload.path alderpointdns-v2-dnsdist alderpointdns-v2-dnsdist-reload.path alderpointdns-v2-analytics alderpointdns-v2-analytics-protobuf-receiver alderpointdns-v2-tierb alderpointdns-v2-schedule alderpointdns-v2-web alderpointdns-v2-discovery alderpointdns-v2-dns-observer alderpointdns-v2-replication alderpointdns-v2-update-apply.path alderpointdns-v2-blocklist-refresh.timer"

alderpointdns_v2_wait_active() {
  # Real defect found live during Gate #3 clean-install acceptance on a
  # genuine (non-container) KVM Debian 13 VM: a Type=simple service that
  # crash-loops immediately after every start (e.g. dnsdist failing an
  # EADDRINUSE bind) is briefly reported "active" by systemd the instant
  # the process is exec'd, before the process itself notices the failure
  # and exits. A single is-active poll can land in that split-second
  # window between restarts and return success even though the service
  # never actually stays up -- which is exactly what happened here: this
  # postinst reported a clean install (dpkg state "ii") while
  # alderpointdns-v2-dnsdist was permanently stuck in
  # activating/auto-restart, never serving a single query. Require the
  # active state to hold across a short confirmation delay before
  # accepting it, not just a single instantaneous check.
  svc="$1"
  i=0
  while [ "$i" -lt 15 ]; do
    if systemctl is-active --quiet "$svc"; then
      sleep 2
      if systemctl is-active --quiet "$svc"; then
        return 0
      fi
      # Flapped back out of active during the confirmation delay -- keep
      # polling rather than failing immediately, in case this was a
      # legitimate one-off restart (e.g. ExecStartPre re-run) rather than
      # a genuine crash loop.
    fi
    i=$((i + 1))
    sleep 1
  done
  return 1
}

case "$1" in
  configure)
    if ! getent group alderpointdns-v2 >/dev/null; then
      addgroup --system alderpointdns-v2
    fi
    if ! id alderpointdns-v2 >/dev/null 2>&1; then
      adduser --system --home /var/lib/alderpointdns-v2 --no-create-home \
        --ingroup alderpointdns-v2 --disabled-login alderpointdns-v2
    fi

    # Real race found live during Gate #3 acceptance testing: bind9 (a
    # V2 Depends:, needed only for its named-checkconf/named-checkzone
    # tooling and the alderpointdns-v2-bind@ template unit's own
    # /usr/sbin/named binary) ships a generic, package-enabled
    # named.service that binds port 53 on ALL interfaces by its own
    # stock /etc/bind/named.conf.options default (no listen-on
    # restriction) -- a real, observed race against V2's own dnsdist for
    # port 53 on a fresh install, won inconsistently depending on
    # service start ordering. V2 never uses the generic named.service --
    # every V2 BIND instance is its own isolated, loopback-only
    # alderpointdns-v2-bind@<ctx> instance -- so it is stopped and
    # disabled here unconditionally. Safe by construction: this package
    # Conflicts: alderpointdns (V1), so apt refuses to let this postinst
    # ever run on a host where V1's own live named.service (the same
    # unit name, V1's own config) could legitimately be depended on.
    if systemctl list-unit-files named.service >/dev/null 2>&1; then
      systemctl stop named.service >/dev/null 2>&1 || true
      systemctl disable named.service >/dev/null 2>&1 || true
    fi
    # Same real race, same fix, for the dnsdist package's own generic
    # dnsdist.service (found live in the same acceptance pass): it also
    # auto-starts post-install (against /etc/dnsdist/dnsdist.conf, not
    # V2's compiled config) and races alderpointdns-v2-dnsdist for port
    # 53. V2 never uses it -- same Conflicts:alderpointdns safety
    # argument applies (V1's own legitimate use of this same unit name
    # can never coexist with a successful V2 postinst run).
    if systemctl list-unit-files dnsdist.service >/dev/null 2>&1; then
      systemctl stop dnsdist.service >/dev/null 2>&1 || true
      systemctl disable dnsdist.service >/dev/null 2>&1 || true
    fi

    # Real defect found live during Gate #3 clean-install acceptance on a
    # genuine (non-container) KVM Debian 13 VM -- reproduces on a stock
    # Debian 13 install and was masked by every prior container-based
    # install test because minimal containers don't run systemd-resolved.
    # systemd-resolved's stub DNS listener is enabled by default on
    # Debian 12/13 and binds specific loopback aliases (127.0.0.53:53,
    # sometimes also 127.0.0.54:53) without SO_REUSEPORT. Because a
    # *wildcard* bind (0.0.0.0:53, what alderpointdns-v2-dnsdist needs) on
    # a port already claimed by any non-SO_REUSEPORT socket -- even one
    # bound to a different, more specific address -- is refused by the
    # kernel, dnsdist's own bind to port 53 fails with EADDRINUSE on a
    # completely unmodified, default fresh install, before this package's
    # own config is even a factor. This is the same class of conflict V1's
    # own postinst already found and fixed (see packaging/debian/postinst)
    # -- V2 never carried the fix forward. Disable only the stub listener
    # and LLMNR; systemd-resolved keeps running and NSS/D-Bus-based name
    # resolution is unaffected.
    if systemctl is-active --quiet systemd-resolved 2>/dev/null; then
      install -d -m 0755 /etc/systemd/resolved.conf.d
      cat > /etc/systemd/resolved.conf.d/alderpointdns-v2-disable-stub.conf <<'RESOLVEDCONF'
# Installed by alderpointdns-v2 (packaging/v2/postinst). Alderpoint DNS V2
# itself listens on port 53 (via alderpointdns-v2-dnsdist) once installed;
# systemd-resolved's stub listener and LLMNR responder conflict with that
# bind (see postinst for the full explanation). Only these two listeners
# are disabled -- systemd-resolved keeps running for everything else.
[Resolve]
DNSStubListener=no
LLMNR=no
RESOLVEDCONF
      systemctl restart systemd-resolved
      # /etc/resolv.conf is normally a symlink to systemd-resolved's
      # dynamic stub file (nameserver 127.0.0.53), which stops answering
      # once the stub listener above is disabled. Repoint it at this
      # host's own Alderpoint DNS V2 listener -- the intended end state
      # for a host running Alderpoint DNS V2 as its resolver anyway --
      # but only when it's still the default symlink/absent; an
      # administrator's own static /etc/resolv.conf (a real, non-symlink
      # file) is left alone rather than silently overwritten.
      if [ -L /etc/resolv.conf ]; then
        rm -f /etc/resolv.conf
        cat > /etc/resolv.conf <<'RESOLVCONFEOF'
# Managed by alderpointdns-v2. systemd-resolved's stub listener was
# disabled (see /etc/systemd/resolved.conf.d/alderpointdns-v2-disable-stub.conf)
# so Alderpoint DNS V2's own dnsdist could bind port 53. Points at this
# host's own Alderpoint DNS V2 listener.
nameserver 127.0.0.1
options edns0 trust-ad
RESOLVCONFEOF
      fi
    fi

    # BIND architecture correction (Gate #3): apparmor's usr.sbin.named
    # profile is keyed by the binary path (/usr/sbin/named), which V1 and
    # V2 both use -- the same real defect V1's own postinst already found
    # and fixed (a default profile that only knows V1's own generated
    # paths denies named read/write access to V2's isolated
    # /var/lib/alderpointdns-v2/bind, /var/log/alderpointdns-v2/bind
    # paths with a "permission denied" that looks like a Unix permissions
    # bug but isn't). Appended (never overwritten) and guarded by its own
    # V2-specific marker so this is idempotent across installs/upgrades
    # and never clobbers V1's own local override entry in the same file
    # (the two packages Conflict and are never co-installed, but the
    # apparmor profile itself is host-wide, not per-package).
    apparmor_local=/etc/apparmor.d/local/usr.sbin.named
    apparmor_marker="# Alderpoint DNS V2 local override -- see /opt/alderpointdns-v2/packaging/apparmor-named-v2.local"
    if [ -d /etc/apparmor.d/local ]; then
      if [ ! -e "$apparmor_local" ] || ! grep -qF "$apparmor_marker" "$apparmor_local" 2>/dev/null; then
        {
          printf '%s\n' "$apparmor_marker"
          cat /opt/alderpointdns-v2/packaging/apparmor-named-v2.local
        } >> "$apparmor_local"
      fi
      if command -v apparmor_parser >/dev/null 2>&1 \
          && [ -e /sys/module/apparmor/parameters/enabled ] \
          && [ "$(cat /sys/module/apparmor/parameters/enabled)" = "Y" ] \
          && [ -e /etc/apparmor.d/usr.sbin.named ]; then
        apparmor_parser -r /etc/apparmor.d/usr.sbin.named || true
      fi
    fi

    # Analytics vendor runtime provisioning (P0-C, Workstream 4A §4):
    # deterministic, idempotent, no network required (wheels are bundled
    # under /opt/alderpointdns-v2/vendor/v2-analytics/). Failure here
    # aborts the install -- an appliance that silently comes up with a
    # broken analytics backend is exactly the "half-functional install"
    # this pass's own instructions forbid.
    if ! /opt/alderpointdns-v2/scripts/provision-v2-analytics-vendor-runtime.sh; then
      echo "alderpointdns-v2: analytics vendor runtime provisioning failed; aborting install." >&2
      exit 1
    fi

    # State/config bootstrap (§5): idempotent, creates only what's
    # missing, never overwrites existing config/control-db/secrets.
    if ! PYTHONPATH=/opt/alderpointdns-v2 python3 -B /opt/alderpointdns-v2/scripts/v2/alderpointdns_v2_ctl.py init-state; then
      echo "alderpointdns-v2: state initialization failed; aborting install." >&2
      exit 1
    fi

    # Generate + validate (real dnsdist --check-config / named-checkzone)
    # the default-install runtime artifacts (§9). Failure here means the
    # bundled generator or an incompatible installed dnsdist/bind9-utils
    # produced something invalid -- must not silently proceed.
    if ! PYTHONPATH=/opt/alderpointdns-v2 python3 -B /opt/alderpointdns-v2/scripts/v2/alderpointdns_v2_ctl.py generate-runtime; then
      echo "alderpointdns-v2: default runtime generation/validation failed; aborting install." >&2
      exit 1
    fi

    # Final ownership pass -- state directory contents may have been
    # created before the service account existed on a very first install
    # (init-state's own chown calls are already best-effort/idempotent;
    # this is redundant defense-in-depth, matching the V1 postinst's own
    # "always reassert ownership on every configure" pattern).
    chown -R alderpointdns-v2:alderpointdns-v2 /var/lib/alderpointdns-v2 /var/log/alderpointdns-v2 2>/dev/null || true
    chown root:alderpointdns-v2 /etc/alderpointdns-v2 2>/dev/null || true
    if [ -e /etc/alderpointdns-v2/alderpointdns.yaml ]; then
      chown root:alderpointdns-v2 /etc/alderpointdns-v2/alderpointdns.yaml
      chmod 0640 /etc/alderpointdns-v2/alderpointdns.yaml
    fi
    chmod 0700 /var/lib/alderpointdns-v2/secrets 2>/dev/null || true

    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl reset-failed $V2_SERVICES >/dev/null 2>&1 || true
    systemctl enable $V2_SERVICES >/dev/null 2>&1 || true
    systemctl restart $V2_SERVICES

    for svc in $V2_SERVICES; do
      if ! alderpointdns_v2_wait_active "$svc"; then
        echo "alderpointdns-v2: $svc did not reach the active state after installation." >&2
        echo "alderpointdns-v2: check 'systemctl status $svc' and 'journalctl -u $svc -n 50' for details." >&2
        exit 1
      fi
    done
    ;;
esac

#DEBHELPER#
exit 0
