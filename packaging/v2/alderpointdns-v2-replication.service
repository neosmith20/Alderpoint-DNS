[Unit]
Description=Alderpoint DNS V2 mTLS replication service
# Same real defect/fix as alderpointdns-v2-discovery.service's own
# comment: this worker's own startup calls
# replication_v2.ensure_schema() directly (which itself cascades into
# policy_store/notification_store/node_identity's own ensure_schema()
# too), taking real write locks against control.db with no boot-time
# ordering guarantee against every other schema-touching worker's own
# startup. See alderpointdns-v2-state-init.service's own comment for
# the full root cause and fix.
After=network.target alderpointdns-v2-state-init.service
Requires=alderpointdns-v2-state-init.service

[Service]
Type=simple
User=alderpointdns-v2
Group=alderpointdns-v2
ExecStartPre=/usr/bin/python3 -B /opt/alderpointdns-v2/scripts/v2/alderpointdns_v2_ctl.py init-replication-cert
ExecStart=/usr/bin/python3 -B /opt/alderpointdns-v2/scripts/v2/alderpointdns_v2_ctl.py replication-server --host 0.0.0.0 --port 9443
Environment=PYTHONPATH=/opt/alderpointdns-v2/vendor-runtime-v2-analytics:/opt/alderpointdns-v2
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/alderpointdns-v2 /var/log/alderpointdns-v2
UMask=0027
CapabilityBoundingSet=
MemoryMax=512M

[Install]
WantedBy=multi-user.target
