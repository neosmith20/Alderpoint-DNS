[Unit]
Description=Alderpoint DNS V2 observed-client discovery worker
# Real defect found live during a real KVM clean-install/reboot
# acceptance: this worker's own startup calls
# observed_clients.ensure_schema() directly, which (like every other
# V2 module's ensure_schema()) took a real write lock against
# control.db -- with no boot-time ordering guarantee that schema was
# already established first, this genuinely raced every other
# schema-touching worker's own startup and once lost that race outright
# (a real "database is locked" past the busy_timeout, not a
# hypothetical one). See alderpointdns-v2-state-init.service's own
# comment for the full root cause and fix.
After=network.target alderpointdns-v2-state-init.service
Requires=alderpointdns-v2-state-init.service

[Service]
Type=simple
User=alderpointdns-v2
Group=alderpointdns-v2
ExecStart=/usr/bin/python3 -B /opt/alderpointdns-v2/scripts/v2/alderpointdns_v2_ctl.py discovery-worker
Environment=PYTHONPATH=/opt/alderpointdns-v2/vendor-runtime-v2-analytics:/opt/alderpointdns-v2
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/alderpointdns-v2 /var/log/alderpointdns-v2
UMask=0027
CapabilityBoundingSet=
MemoryMax=256M

[Install]
WantedBy=multi-user.target
