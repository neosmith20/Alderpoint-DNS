#!/bin/sh
set -e

# Remove vs purge (§17): ordinary `apt-get remove` / `dpkg -r` must never
# destroy user state -- config, control.db, secrets, analytics history,
# backups all survive an ordinary remove, exactly like the live V1
# package's own /var/lib/alderpointdns is untouched by a plain remove.
# `apt-get purge` / `dpkg -P` is the explicit, deliberate "delete
# everything this package owns" operation.

case "$1" in
  remove)
    # Real defect found live during rc45 clean-install/purge acceptance
    # testing: this list predates Software Updates apply, Network
    # Configuration apply/confirm, and subscribed Blocklist refresh, so
    # a real `apt-get purge` left alderpointdns-v2-network-apply.path/
    # alderpointdns-v2-network-confirm.path (and, by the same gap,
    # update-apply.path and blocklist-refresh.timer) loaded and
    # "active" in systemd's own view even though dpkg had already
    # deleted their unit files out from under it -- confirmed via
    # `systemctl list-units` showing them "not-found active waiting"
    # immediately after a real purge completed with no error. Every
    # unit this package's postinst enables must be disabled here too.
    systemctl disable alderpointdns-v2-bind-reload.path alderpointdns-v2-doh-egress@dohctx0.service alderpointdns-v2-doh-egress@dohctx1.service alderpointdns-v2-doh-egress@dohctx2.service alderpointdns-v2-doh-egress@dohctx3.service alderpointdns-v2-bind@ctx0.service alderpointdns-v2-bind@ctx1.service alderpointdns-v2-bind@ctx2.service alderpointdns-v2-bind@ctx3.service alderpointdns-v2-dnsdist-reload.path alderpointdns-v2-dnsdist alderpointdns-v2-analytics alderpointdns-v2-analytics-protobuf-receiver alderpointdns-v2-tierb alderpointdns-v2-schedule alderpointdns-v2-web alderpointdns-v2-discovery alderpointdns-v2-dns-observer alderpointdns-v2-replication alderpointdns-v2-update-apply.path alderpointdns-v2-network-apply.path alderpointdns-v2-network-confirm.path alderpointdns-v2-blocklist-refresh.timer >/dev/null 2>&1 || true
    systemctl daemon-reload >/dev/null 2>&1 || true
    # /opt/alderpointdns-v2 itself is package-owned content (code, vendor
    # wheels, the provisioned analytics vendor runtime) -- dpkg already
    # removes everything it tracked; the provisioned vendor-runtime
    # directory is generated at install time, not tracked by dpkg, so it
    # is removed explicitly here (safe: it is 100% reproducible from the
    # bundled wheels, never user state). Likewise __pycache__/*.pyc under
    # app/v2/ are generated by the interpreter at runtime, not tracked by
    # dpkg -- found via real clean-install testing: without this, dpkg
    # leaves a "directory not empty" warning and an orphaned
    # /opt/alderpointdns-v2/app/v2/ directory behind after removal.
    rm -rf /opt/alderpointdns-v2/vendor-runtime-v2-analytics
    find /opt/alderpointdns-v2 -depth -name __pycache__ -type d -exec rm -rf {} + 2>/dev/null || true
    ;;
  purge)
    # Real defect found live during rc45 clean-install/purge acceptance
    # testing: this list predates Software Updates apply, Network
    # Configuration apply/confirm, and subscribed Blocklist refresh, so
    # a real `apt-get purge` left alderpointdns-v2-network-apply.path/
    # alderpointdns-v2-network-confirm.path (and, by the same gap,
    # update-apply.path and blocklist-refresh.timer) loaded and
    # "active" in systemd's own view even though dpkg had already
    # deleted their unit files out from under it -- confirmed via
    # `systemctl list-units` showing them "not-found active waiting"
    # immediately after a real purge completed with no error. Every
    # unit this package's postinst enables must be disabled here too.
    systemctl disable alderpointdns-v2-bind-reload.path alderpointdns-v2-doh-egress@dohctx0.service alderpointdns-v2-doh-egress@dohctx1.service alderpointdns-v2-doh-egress@dohctx2.service alderpointdns-v2-doh-egress@dohctx3.service alderpointdns-v2-bind@ctx0.service alderpointdns-v2-bind@ctx1.service alderpointdns-v2-bind@ctx2.service alderpointdns-v2-bind@ctx3.service alderpointdns-v2-dnsdist-reload.path alderpointdns-v2-dnsdist alderpointdns-v2-analytics alderpointdns-v2-analytics-protobuf-receiver alderpointdns-v2-tierb alderpointdns-v2-schedule alderpointdns-v2-web alderpointdns-v2-discovery alderpointdns-v2-dns-observer alderpointdns-v2-replication alderpointdns-v2-update-apply.path alderpointdns-v2-network-apply.path alderpointdns-v2-network-confirm.path alderpointdns-v2-blocklist-refresh.timer >/dev/null 2>&1 || true
    systemctl daemon-reload >/dev/null 2>&1 || true
    rm -rf /opt/alderpointdns-v2/vendor-runtime-v2-analytics
    find /opt/alderpointdns-v2 -depth -name __pycache__ -type d -exec rm -rf {} + 2>/dev/null || true
    # Purge deliberately destroys everything this package owns, including
    # secrets and control state -- this is the one path where that is the
    # correct, expected, and documented behavior (§17).
    rm -rf /var/lib/alderpointdns-v2
    rm -rf /var/log/alderpointdns-v2
    rm -rf /etc/alderpointdns-v2
    if getent passwd alderpointdns-v2 >/dev/null; then
      deluser --system alderpointdns-v2 >/dev/null 2>&1 || true
    fi
    if getent group alderpointdns-v2 >/dev/null; then
      delgroup --system alderpointdns-v2 >/dev/null 2>&1 || true
    fi
    ;;
esac

exit 0
