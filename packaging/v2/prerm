#!/bin/sh
set -e

# Stop the three worker services on both ordinary removal and upgrade
# (dpkg calls prerm remove/upgrade); state/config/secrets themselves are
# left untouched here -- postrm's `remove` case (not `purge`) is what
# decides final disposition, per Debian convention and this package's own
# §17 remove-vs-purge contract (see postrm).
case "$1" in
  remove|upgrade|deconfigure)
    systemctl stop alderpointdns-v2-bind-reload.path alderpointdns-v2-bind@ctx0.service alderpointdns-v2-bind@ctx1.service alderpointdns-v2-bind@ctx2.service alderpointdns-v2-bind@ctx3.service alderpointdns-v2-dnsdist-reload.path alderpointdns-v2-dnsdist alderpointdns-v2-analytics alderpointdns-v2-analytics-protobuf-receiver alderpointdns-v2-tierb alderpointdns-v2-schedule alderpointdns-v2-web alderpointdns-v2-discovery alderpointdns-v2-dns-observer alderpointdns-v2-replication >/dev/null 2>&1 || true
    ;;
esac

exit 0
