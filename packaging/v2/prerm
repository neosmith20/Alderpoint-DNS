#!/bin/sh
set -e

# Stop the three worker services on both ordinary removal and upgrade
# (dpkg calls prerm remove/upgrade); state/config/secrets themselves are
# left untouched here -- postrm's `remove` case (not `purge`) is what
# decides final disposition, per Debian convention and this package's own
# §17 remove-vs-purge contract (see postrm).
case "$1" in
  remove|upgrade|deconfigure)
    # Real defect found live during rc45 clean-install/purge acceptance
    # testing: this list was never updated for Network Configuration's
    # two new .path units (added the same pass as this comment), so a
    # real remove/purge left them "not-found active waiting" in
    # systemd's own view -- see postrm's matching fix for the full
    # symptom.
    systemctl stop alderpointdns-v2-state-init alderpointdns-v2-bind-reload.path alderpointdns-v2-doh-egress@dohctx0.service alderpointdns-v2-doh-egress@dohctx1.service alderpointdns-v2-doh-egress@dohctx2.service alderpointdns-v2-doh-egress@dohctx3.service alderpointdns-v2-bind@ctx0.service alderpointdns-v2-bind@ctx1.service alderpointdns-v2-bind@ctx2.service alderpointdns-v2-bind@ctx3.service alderpointdns-v2-dnsdist-reload.path alderpointdns-v2-dnsdist alderpointdns-v2-analytics alderpointdns-v2-analytics-protobuf-receiver alderpointdns-v2-tierb alderpointdns-v2-schedule alderpointdns-v2-web alderpointdns-v2-discovery alderpointdns-v2-dns-observer alderpointdns-v2-replication alderpointdns-v2-update-apply.path alderpointdns-v2-network-apply.path alderpointdns-v2-network-confirm.path alderpointdns-v2-blocklist-refresh.timer >/dev/null 2>&1 || true
    ;;
esac

exit 0
