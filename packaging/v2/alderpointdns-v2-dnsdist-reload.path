[Unit]
Description=Watch Alderpoint DNS V2 promoted dnsdist runtime for reload
After=alderpointdns-v2-dnsdist.service

[Path]
PathChanged=/var/lib/alderpointdns-v2/compiled/dnsdist.conf
PathModified=/var/lib/alderpointdns-v2/compiled/dnsdist.conf
Unit=alderpointdns-v2-dnsdist-reload.service

[Install]
WantedBy=multi-user.target
