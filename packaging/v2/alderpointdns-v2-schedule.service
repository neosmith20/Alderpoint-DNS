[Unit]
Description=Alderpoint DNS V2 schedule transition worker (private candidate)
# DNS-first startup order (locked architecture): a failed/false recompile
# tick leaves the previously-promoted compiled runtime untouched
# (ScheduleTransitionRuntime.tick() returns promotion_succeeded=False
# without raising, per app/v2/schedule_runtime.py's own contract) -- it
# never un-promotes a working config, so this worker can never regress an
# already-answering DNS runtime, only fail to advance it.
# Defensive ordering (same real defect class as
# alderpointdns-v2-discovery.service's own comment, audited for every
# V2 service during that same pass): this worker's own on_start/tick
# writes to control.db via webapp._mutate_and_promote(), which does
# not itself call ensure_schema() (schema is assumed already
# established) -- ordering after schema is deterministically
# established removes any dependency on that assumption being true by
# luck of boot timing.
After=network.target alderpointdns-v2-state-init.service
Requires=alderpointdns-v2-state-init.service

[Service]
Type=simple
User=alderpointdns-v2
Group=alderpointdns-v2
ExecStart=/usr/bin/python3 -B /opt/alderpointdns-v2/scripts/v2/alderpointdns_v2_ctl.py schedule-worker --interval-seconds 60
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Real defect found live during a real V1->V2 migration/restart
# acceptance test (beta-rescue continuation): this worker's on_start()
# unconditionally recompiles from the actual current control.db policy
# state on every single service start (app/v2/schedule_runtime.py's own
# §26 contract -- startup itself is treated as an implicit transition),
# so it needs the same broad read/write access to control.db, secrets,
# certs, and BIND's own working directory that a real policy mutation
# through the management API needs (see alderpointdns-v2-web.service's
# own ReadWritePaths) -- not just compiled/ and staging/. Under the
# previous narrower list, every restart of this unit (i.e. every
# reboot) would have failed to even read control.db, or -- worse, the
# actual defect this pass found and fixed alongside this -- silently
# recompiled from an empty bootstrap default instead of real policy,
# wiping every configured block domain/upstream/encrypted-transport
# setting back to nothing on every restart with no error surfaced
# anywhere.
# /etc/alderpointdns-v2 added to this list (real defect found live on
# the owner preview, Aug 23-24, pre-DoH reliability pass): on_transition
# below reuses app.v2.webapp._mutate_and_promote() (see this unit's own
# docstring on that refactor), and that function unconditionally passes
# live_rndc_conf_path=RNDC_CONF_PATH (/etc/alderpointdns-v2/rndc.conf)
# once COMPILED_RPZ_ZONE exists -- true on any real install, not just an
# interactive one. alderpointdns-v2-web.service's own comment on its
# identical ReadWritePaths entry claims "the scheduled recompile path
# never hit this because it never passes live_rndc_conf_path" -- that
# was true only of the old, separate recompile implementation this unit
# used to run; reusing _mutate_and_promote made it false without either
# unit's ReadWritePaths being revisited. Confirmed live: this worker's
# own scheduled tick (every interval-seconds, i.e. every 60s) raised
# "[Errno 30] Read-only file system: '/etc/alderpointdns-v2/.rndc.conf.tmp'"
# on essentially every single tick since the refactor landed -- caught by
# on_transition's own try/except (see below) and _mutate_and_promote's
# all-or-nothing rollback, so no DNS/config regression ever resulted
# (the previously-promoted runtime stayed live throughout), but every
# scheduled policy transition silently failed to ever actually promote.
# See tests/v2/test_packaging_unit_lifecycle_consistency.py's
# test_units_reaching_mutate_and_promote_can_write_rndc_conf_dir for the
# regression guard.
ReadWritePaths=/var/lib/alderpointdns-v2 /var/log/alderpointdns-v2 /etc/alderpointdns-v2
UMask=0027
CapabilityBoundingSet=
# Real defect found live during a real KVM clean-install/reboot
# acceptance: this worker's on_transition hook calls
# app/v2/webapp.py's _mutate_and_promote() in-process (see this unit's
# own comment above), which stages+validates the real compiled
# runtime via app/v2/runtime_staging.py's stage_validate_promote_all()
# -- real subprocess invocations of `dnsdist --check-config` /
# `named-checkconf` / `named-checkzone` against the full real default
# blocklist configuration (~450k+ domains). Those child processes
# inherit THIS unit's own cgroup (a plain subprocess.run() does not
# get its own cgroup -- cgroup v2 memory.max is enforced hierarchically,
# so no descendant process can ever exceed an ancestor's cap regardless
# of its own settings), so this cap has to cover this worker's own
# baseline *plus* the validator subprocess's real peak, not just the
# worker's own footprint. 256M was sized only for the latter. Measured
# live: a real `dnsdist --check-config` against the full default
# three-blocklist ruleset needs comparable memory to the running daemon
# itself (~569M baseline, see alderpointdns-v2-dnsdist.service's own
# MemoryMax comment) -- 256M reproducibly cgroup-oom-killed this
# worker's own process (and the dnsdist check-config child alongside
# it) every time a real schedule transition tried to recompile,
# producing a real, sustained crash loop after every reboot. Matched to
# alderpointdns-v2-dnsdist.service's own 1024M floor: real headroom
# above the measured baseline, still a real bounded cap. See
# tests/v2/test_packaging_unit_lifecycle_consistency.py's
# test_every_runtime_validating_unit_has_adequate_memory_cap for the
# regression guard covering this and every other unit whose code path
# can reach the same validators.
MemoryMax=1024M

[Install]
WantedBy=multi-user.target
