[Unit]
Description=Alderpoint DNS V2 Tier B prewarm worker (private candidate)
# DNS-first startup order (locked architecture): prewarm only ever
# replays queries through the *normal* DNS path (app/v2/tier_b_prewarm.py
# resolve_fn is a plain client resolve, never a bypass) -- it structurally
# cannot run before DNS is already answering, and a corrupt/missing
# working-set snapshot degrades to "prewarm attempts nothing this tick,"
# never a startup failure.
After=network.target

[Service]
Type=simple
User=alderpointdns-v2
Group=alderpointdns-v2
ExecStart=/usr/bin/python3 -B /opt/alderpointdns-v2/scripts/v2/alderpointdns_v2_ctl.py tier-b-worker --interval-seconds 300
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Real defect found live during a real KVM clean-install/reboot
# acceptance: scoping ReadWritePaths to just this unit's own leaf
# subdirectories (tierb/, worker-heartbeats/) means ProtectSystem=strict's
# bind-mount setup needs each of those exact paths to already exist on
# a real fresh boot -- and postinst creating them is not itself
# ordered before systemd starts this unit, so a real fresh boot could
# (and did) start this service before /var/lib/alderpointdns-v2/worker-heartbeats
# existed yet: "Failed to set up mount namespacing: ... No such file or
# directory", the unit failing its first start attempt every time
# (masked only by Restart=on-failure's retry succeeding a few seconds
# later, once the directory existed). This is the exact same
# whole-state-directory lesson alderpointdns-v2-analytics.service's own
# comment above already documents for a different reason (a real SQLite
# WAL -shm file needing write access outside the narrowly-scoped
# subdirs) -- matching that unit (and alderpointdns-v2-schedule.service,
# alderpointdns-v2-discovery.service) removes this unit's own
# unnecessarily narrow scoping and its startup-ordering fragility along
# with it.
ReadWritePaths=/var/lib/alderpointdns-v2 /var/log/alderpointdns-v2
UMask=0027
CapabilityBoundingSet=
MemoryMax=256M

[Install]
WantedBy=multi-user.target
