[Unit]
Description=Alderpoint DNS V2 analytics ingestion worker (private candidate)
# DNS-first startup order (Workstream 4A §8, locked architecture): this
# unit is NOT a dependency of any DNS-serving process, and nothing in
# this package's dnsdist/BIND config generation (alderpointdns-v2-ctl
# generate-runtime) waits on it either. It exists solely so a broken or
# slow analytics backend can never hold DNS readiness hostage -- there is
# deliberately no Requires=/After= relationship in the other direction.
After=network.target

[Service]
Type=simple
User=alderpointdns-v2
Group=alderpointdns-v2
ExecStart=/usr/bin/python3 -B /opt/alderpointdns-v2/scripts/v2/alderpointdns_v2_ctl.py analytics-worker --interval-seconds 1
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30

# Hardening (Workstream 4A §7). Documented exceptions:
#  - ProtectHome=true, not "read-only": this service never touches /home.
#  - ReadWritePaths covers the whole state directory, not just
#    analytics/tierb -- this worker now resolves real per-client
#    query_log_enabled/statistics_enabled exclusions against control.db
#    (roadmap Priority 6 continuation) via a real read-only SQLite
#    connection. A genuine read-only connection to a database another
#    process holds open in WAL mode still needs write access to that
#    database's own -shm locking file (a real SQLite WAL constraint,
#    not something this service's own code chooses to do) -- confirmed
#    live: scoping ReadWritePaths to only analytics/tierb still failed
#    with "unable to open database file" even for a read-only
#    connection. Matches the same ReadWritePaths scope the web and
#    discovery services (which genuinely write control.db) already use
#    -- this worker itself never writes to control.db, only reads it.
#  - RestrictAddressFamilies excludes AF_NETLINK/AF_PACKET (not needed --
#    this worker only does file I/O; it makes no network calls of its own)
#    but keeps AF_UNIX/AF_INET/AF_INET6 since the queue-drain path may run
#    in the same process as future socket-based ingestion.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/alderpointdns-v2 /var/log/alderpointdns-v2
UMask=0027
CapabilityBoundingSet=
MemoryMax=512M

[Install]
WantedBy=multi-user.target
