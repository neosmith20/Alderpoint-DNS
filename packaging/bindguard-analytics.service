[Unit]
Description=BindGuard Analytics Collector
After=network-online.target dnsdist.service named.service
Wants=network-online.target

[Service]
User=bindguard
Group=bindguard
WorkingDirectory=/opt/bindguard
Environment=PYTHONPATH=/opt/bindguard
ExecStart=/opt/bindguard/app/analytics.py run
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/bindguard /etc/bindguard

[Install]
WantedBy=multi-user.target
