#!/bin/sh
set -e

# Poll for a service reaching the active state instead of checking once
# immediately after `systemctl restart`: a fast-crashing service (bad
# config, permissions) has not necessarily been marked failed yet the
# instant systemctl returns.
apdns_go_wait_active() {
  svc="$1"
  i=0
  while [ "$i" -lt 15 ]; do
    if systemctl is-active --quiet "$svc"; then
      return 0
    fi
    i=$((i + 1))
    sleep 1
  done
  return 1
}

case "$1" in
  configure)
    if ! getent group apdns-go-web >/dev/null; then
      addgroup --system apdns-go-web
    fi
    if ! id apdns-go-web >/dev/null 2>&1; then
      adduser --system --home /var/lib/alderpointdns-go --no-create-home --ingroup apdns-go-web --disabled-login apdns-go-web
    fi

    install -d -o apdns-go-web -g apdns-go-web -m 0750 \
      /var/lib/alderpointdns-go \
      /var/lib/alderpointdns-go/data \
      /var/lib/alderpointdns-go/backups \
      /var/lib/alderpointdns-go/secret-backups \
      /var/lib/alderpointdns-go/replication-certs
    install -d -o root -g apdns-go-web -m 0750 /etc/alderpointdns-go
    install -d -o root -g root -m 0700 \
      /var/lib/apdns-hostagent \
      /var/lib/apdns-hostagent/secrets \
      /var/lib/apdns-hostagent/dns-staging \
      /var/lib/apdns-hostagent/update-staging
    install -d -o root -g root -m 0700 /var/log/apdns-hostagent
    # 2026-09-04: a real, confirmed-live packaging defect, found by the
    # first genuine native-systemd install/start/configure test this
    # package ever had -- named (see cmd/apdns-hostagent's ops_dnsruntime.go,
    # a plain exec.CommandContext with no Credential/-u drop) always
    # actually runs as root, the same UID as apdns-hostagent itself, never
    # as the separate "bind" system account. BIND9 on Linux drops
    # CAP_DAC_OVERRIDE as part of its own internal privilege hardening
    # even while remaining UID 0, so its startup directory-writability
    # self-check then falls back to plain DAC: owning UID must match
    # exactly, or the write is refused -- confirmed by direct reproduction
    # (a bind:bind 0755 directory makes named exit immediately with
    # "directory ... is not writable" / "permission denied" on every
    # single promote attempt; the identical directory as root:root works).
    # The previous conditional here assumed the OPPOSITE (that named runs
    # as "bind"), and since bind9 is a real package dependency, `getent
    # passwd bind` always succeeds by the time this postinst runs -- so
    # the one branch that was ever actually taken in practice was the
    # broken one; the working root:root branch was unreachable dead code.
    # Always root:root now, matching the real live deployment's own
    # directory (confirmed directly: /var/lib/bind/apdns-go-live is
    # root:root on the live appliance, which is why live was never
    # affected by this).
    install -d -o root -g root -m 0755 /var/lib/bind/alderpointdns-go

    # A real self-signed cert so the management UI serves HTTPS from the
    # very first boot, before the owner has configured anything through
    # the Encryption page -- same real openssl invocation this product's
    # own V1.1.1 predecessor used (packaging/debian's own
    # ensure_tls_cert.sh, ported here), refusing to overwrite partial
    # material rather than silently regenerating over it.
    cert_dir=/etc/alderpointdns-go/certs
    cert_file="$cert_dir/apdns-web.crt"
    key_file="$cert_dir/apdns-web.key"
    install -d -m 0751 -o root -g apdns-go-web "$cert_dir"
    if [ -f "$cert_file" ] && [ -f "$key_file" ]; then
      : # already provisioned -- never overwrite real cert material
    elif [ -e "$cert_file" ] || [ -e "$key_file" ]; then
      echo "apdns-go: refusing to overwrite partial TLS material in $cert_dir" >&2
    else
      openssl req -x509 -newkey rsa:3072 -sha256 -days 825 -nodes \
        -subj "/CN=alderpointdns-go.local" \
        -addext "subjectAltName=DNS:alderpointdns-go.local,IP:127.0.0.1" \
        -keyout "$key_file" -out "$cert_file" 2>/dev/null
      chown root:apdns-go-web "$cert_file" "$key_file"
      chmod 0644 "$cert_file"
      chmod 0640 "$key_file"
    fi

    if [ ! -f /etc/alderpointdns-go/appliance.yaml ]; then
      cat > /etc/alderpointdns-go/appliance.yaml <<EOF
schema_version: 1
web:
  tls_cert_path: "$cert_file"
  tls_key_path: "$key_file"
appliance:
  name: "Alderpoint DNS"
  timezone: "UTC"
EOF
      chown root:apdns-go-web /etc/alderpointdns-go/appliance.yaml
      chmod 0640 /etc/alderpointdns-go/appliance.yaml
    else
      # The file already exists -- either it's the real default template
      # this package ships as a conffile (go/config/appliance.yaml,
      # deliberately shipped with EMPTY tls_cert_path/tls_key_path, since
      # the real cert path can only be known here, at install time), or
      # an operator's own pre-existing config from an earlier install. A
      # real bug fixed here: dpkg unpacks a conffile BEFORE postinst
      # ever runs, so the `if [ ! -f ... ]` branch above always sees the
      # file as already present on a fresh install and used to skip cert
      # path filling entirely -- leaving a real appliance.yaml with two
      # empty path fields even though a real cert had genuinely just
      # been generated a few lines above. Only ever patches an empty
      # placeholder value, never a real path an operator (or an earlier
      # run of this same block) already filled in -- safe to run on
      # every install/upgrade, not just the first.
      if grep -q 'tls_cert_path: ""' /etc/alderpointdns-go/appliance.yaml 2>/dev/null; then
        sed -i "s#tls_cert_path: \"\"#tls_cert_path: \"$cert_file\"#" /etc/alderpointdns-go/appliance.yaml
      fi
      if grep -q 'tls_key_path: ""' /etc/alderpointdns-go/appliance.yaml 2>/dev/null; then
        sed -i "s#tls_key_path: \"\"#tls_key_path: \"$key_file\"#" /etc/alderpointdns-go/appliance.yaml
      fi
    fi

    # apdns-hostagent's -allowed-uid must be the REAL numeric UID of the
    # web service account, resolved fresh here rather than hardcoded --
    # -allowed-uid is the entire SO_PEERCRED authorization boundary
    # between the unprivileged web process and this privileged one (see
    # internal/hostagentd's own doc comment).
    web_uid="$(id -u apdns-go-web)"
    printf 'APDNS_WEB_UID=%s\n' "$web_uid" > /etc/alderpointdns-go/hostagent.env
    chmod 0644 /etc/alderpointdns-go/hostagent.env

    systemctl daemon-reload >/dev/null 2>&1 || true
    # 2026-09-04: a second real finding from the same native-install test
    # that found the directory-ownership bug above. bind9 and dnsdist are
    # real apt Depends (this appliance drives them itself, as
    # apdns-hostagent-spawned CHILD PROCESSES, never via systemd -- see
    # apdns-hostagent.service's own doc comment), but installing those
    # packages also enables THEIR OWN generic named.service/dnsdist.service
    # units by normal Debian postinst convention. Confirmed directly: a
    # fresh install leaves both `enabled` (only a build sandbox's
    # policy-rc.d, not a real machine, stopped them from actually starting
    # during this install). Left alone, a real reboot would start a second,
    # unconfigured named/dnsdist competing for the exact same real :53 this
    # appliance's own DNS-runtime-managed instances need -- disabled here
    # so only the hostagent-managed instances this appliance actually
    # configures ever run.
    systemctl disable --now named.service bind9.service dnsdist.service >/dev/null 2>&1 || true
    # Units are installed and enabled, but deliberately NOT started here:
    # a real DNS Runtime promote (BIND/dnsdist) needs bind9/dnsdist
    # actually configured, which only happens through this control
    # plane's own setup wizard -- starting the web service before that is
    # harmless (it serves the setup wizard itself), but this package makes
    # no assumption about whether the operator wants it running
    # immediately versus after reviewing appliance.yaml first. On an
    # UPGRADE (not a fresh install), both services are restarted for real
    # so the new binary actually takes effect, exactly matching this
    # package's own self-update path's own restart-and-verify contract.
    systemctl enable apdns-hostagent.service alderpointdns-go.service >/dev/null 2>&1 || true
    # Safe to enable+start unconditionally, even on a fresh install
    # before alderpointdns-go.service is ever started: the healthcheck
    # unit's own Requisite= means a tick against a not-yet-running
    # service simply fails harmlessly rather than doing anything (see
    # alderpointdns-go-healthcheck.service's own comment for why this
    # exists -- OOM-incident parity with the live container deployment's
    # own --health-cmd/--health-on-failure=restart).
    systemctl enable --now alderpointdns-go-healthcheck.timer >/dev/null 2>&1 || true
    if systemctl is-active --quiet apdns-hostagent.service 2>/dev/null || systemctl is-active --quiet alderpointdns-go.service 2>/dev/null; then
      systemctl restart apdns-hostagent.service
      if ! apdns_go_wait_active apdns-hostagent.service; then
        echo "apdns-go: apdns-hostagent.service did not become active after upgrade -- check 'systemctl status apdns-hostagent'" >&2
      fi
      systemctl restart alderpointdns-go.service
      if ! apdns_go_wait_active alderpointdns-go.service; then
        echo "apdns-go: alderpointdns-go.service did not become active after upgrade -- check 'systemctl status alderpointdns-go'" >&2
      fi
    fi
    ;;
esac

#DEBHELPER#
exit 0
